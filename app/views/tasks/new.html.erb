<h1>New Task</h1>

<%= form_with model: @task do |f| %>
  <div>
    <%= f.label :title %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :details %><br>
    <%= f.text_area :details %>
  </div>

  <div>
    <%= f.submit "Create Task", class: "btn btn-primary" %>
  </div>
<% end %>

<hr>
<%= link_to "Back to list", tasks_path %>
